# Contact form delivery (https://resend.com)
# All three must be set for the /api/contact route to send mail.
# Without them the form still validates and returns success, and the
# submission is written to the server log instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@azimuth-ai.com
CONTACT_FROM_EMAIL=website@azimuth-ai.com
